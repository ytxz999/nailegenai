<!DOCTYPE html>
<html lang="zh-CN"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>奶了个奶</title>
<link rel="stylesheet" href="styles/base.css">
<link rel="stylesheet" href="styles/layout.css">
<link rel="stylesheet" href="styles/board.css">
<link rel="stylesheet" href="styles/tray.css">
<link rel="stylesheet" href="styles/holding.css">
<link rel="stylesheet" href="styles/prop.css">
<link rel="stylesheet" href="styles/modal.css">
<!-- 迭代 6：一次性反馈动画（飘字 / 回弹 / 脉冲 / 通关暖光），放最后便于覆盖 -->
<link rel="stylesheet" href="styles/animations.css">
</head>
<body>
  <div class="app">
    <!-- ① 顶部状态栏：剩余 / 步数 / 用时 / 状态 + 暂停（FR-02、FR-15） -->
    <header class="hud">
      <span class="hud__title" id="hud-level">—</span>
      <span class="hud__stat">剩余 <b id="hud-remaining">0</b></span>
      <span class="hud__stat">步数 <b id="hud-moves">0</b></span>
      <span class="hud__stat">用时 <b id="hud-time">0:00</b></span>
      <span class="hud__stat">状态 <b id="hud-state" data-state="Idle">未开始</b></span>
      <button type="button" class="btn btn--ghost hud__settings" id="btn-settings">设置</button>
      <button type="button" class="btn btn--ghost hud__pause" id="btn-pause" disabled="">暂停</button>
    </header>

    <!-- ② 牌堆区：.stage 用固定像素尺寸，靠 transform: scale(k) 等比适配窗口 -->
    <main class="stage-wrap" id="stage-wrap">
      <div class="stage" id="stage"></div>
    </main>

    <!-- ③ 道具区：撤销 / 移出 / 洗牌，次数来自关卡配置（FR-16～20） -->
    <div class="propbar propbar--locked" id="propbar"><button type="button" class="prop prop--undo is-empty" data-kind="undo" title="撤销" disabled=""><span class="prop__glyph">↩</span><span class="prop__label">撤销</span><span class="prop__count">×0</span></button><button type="button" class="prop prop--remove is-empty" data-kind="remove" title="移出" disabled=""><span class="prop__glyph">⇪</span><span class="prop__label">移出</span><span class="prop__count">×0</span></button><button type="button" class="prop prop--shuffle is-empty" data-kind="shuffle" title="洗牌" disabled=""><span class="prop__glyph">⇄</span><span class="prop__label">洗牌</span><span class="prop__count">×0</span></button></div>

    <!-- ④ 底部一行：左"移出"暂存区（3 格，牌可点回槽位），右槽位区（固定 7 格）
         槽位消除后剩下的牌往前压紧（R-09）；移出的牌单独拿出来（R-13） -->
    <footer class="tray-row">
      <div class="holding-wrap">
        <div class="holding" id="holding"><div class="slot slot--holding" data-holding-slot="0"></div><div class="slot slot--holding" data-holding-slot="1"></div><div class="slot slot--holding" data-holding-slot="2"></div></div>
        <div class="holding__caption">移出暂存（可点回槽位）</div>
      </div>

      <div class="tray-wrap">
        <div class="tray" id="tray"><div class="slot" data-slot="0"></div><div class="slot" data-slot="1"></div><div class="slot" data-slot="2"></div><div class="slot" data-slot="3"></div><div class="slot" data-slot="4"></div><div class="slot" data-slot="5"></div><div class="slot" data-slot="6"></div></div>
        <div class="tray__hint">槽满 7 张且本次未凑成三张 → 失败</div>
      </div>
    </footer>

    <!-- ⑤ 弹窗层由 dialogs.js 动态创建并挂在 body 上 -->
  </div>

  <!--
    加载方式说明（重要）：
    本项目要求"双击 index.html 即可运行、无构建、无网络请求"（NFR-01），
    而浏览器对 file:// 协议下的 <script type="module"> 会按 CORS 拦截，
    直接双击打开会报 "Access to script ... from origin 'null' has been blocked"。
    因此这里用**经典脚本 + 单命名空间 window.SM**，按依赖顺序加载：
    只有严格按"被依赖者在前"的顺序写，才能让每个文件在自执行时拿到上游类型。
  -->
  <script src="src/model/tile.js"></script>
  <script src="src/model/icon-set.js"></script>
  <script src="src/model/level-config.js"></script>
  <script src="src/model/board.js"></script>
  <script src="src/model/tray.js"></script>
  <script src="src/model/holding.js"></script>
  <script src="src/data/schema.js"></script>
  <script src="src/data/storage-adapter.js"></script>
  <script src="src/data/levels.js"></script>
  <script src="src/data/fixture.js"></script>
  <script src="src/data/repository.js"></script>
  <script src="src/engine/event-bus.js"></script>
  <script src="src/engine/timer.js"></script>
  <script src="src/engine/level-generator.js"></script>
  <script src="src/engine/command.js"></script>
  <script src="src/engine/undo-manager.js"></script>
  <!-- 道具登记表（P07 走查 S-1）：必须排在 prop-manager 之前，KINDS 由它提供 -->
  <script src="src/engine/prop-table.js"></script>
  <script src="src/engine/prop-manager.js"></script>
  <script src="src/engine/game.js"></script>
  <script src="src/view/icon-face.js"></script>
  <!-- 槽格视图基类（P07 走查 S-2）：tray-view / holding-view 都在它之上 -->
  <script src="src/view/slot-strip-view.js"></script>
  <script src="src/view/board-view.js"></script>
  <script src="src/view/tray-view.js"></script>
  <script src="src/view/holding-view.js"></script>
  <script src="src/view/hud.js"></script>
  <script src="src/view/prop-bar.js"></script>
  <script src="src/view/dialogs.js"></script>
  <script src="src/view/settings-panel.js"></script>
  <script src="src/view/effects.js"></script>
<script src="src/audio/sound.js"></script>
<script src="src/view/renderer.js"></script>
  <script src="src/view/input.js"></script>
  <script src="src/main.js"></script>


<div class="modal" role="dialog" aria-modal="true"><div class="modal__panel"><h2 class="modal__title">奶了个奶</h2><div class="modal__body"><p class="modal__line">点一张没被压住的牌，它飞进底部槽位；同图标凑满三张立即消除。</p><p class="modal__line">槽位满 7 张且这一次没凑成三张 → 失败。</p></div><div class="modal__actions"><button type="button" class="btn btn--primary">进入「入门」 60 张</button><button type="button" class="btn">进入「进阶」 108 张</button><button type="button" class="btn">进入「挑战」 144 张</button></div></div></div></body></html>
